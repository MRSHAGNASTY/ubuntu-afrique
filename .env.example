# Ubuntu Afrique -- WRITE database (own Supabase project)
# NEVER set these to the Aureus production project fgubaqoftdeefcakejwu
VITE_UBUNTU_SUPABASE_URL=https://rbyipalrasawbjpsppgu.supabase.co
VITE_UBUNTU_SUPABASE_ANON_KEY=sb_publishable_your_ubuntu_publishable_key

# Aureus Africa -- READ ONLY (live project)
# Code blocks insert/update/delete/rpc against this client
VITE_AUREUS_SUPABASE_URL=https://fgubaqoftdeefcakejwu.supabase.co
VITE_AUREUS_SUPABASE_ANON_KEY=sb_publishable_your_aureus_publishable_key

# Server only. Never prefix these with VITE_
UA_SESSION_SECRET=generate_a_long_random_string
AUREUS_SERVICE_ROLE_KEY=sb_secret_your_aureus_secret_key

# Server only. Required to confirm paid card/fraction orders and close BLP periods.
UA_COMMERCE_CONFIRM_SECRET=generate_a_long_random_string

# Ubuntu-only staging PSP webhook HMAC. Never an Aureus PSP key.
UA_PSP_WEBHOOK_SECRET=generate_a_long_random_string

# Wave X-BSC. Ubuntu company receive wallet. Never an Aureus or Shopify key.
# When set, member pay is USDT hash verify. Does not mint Aureus shares.
UA_BSC_COMPANY_WALLET=
UA_BSC_RPC_URL=https://bsc-dataseed.binance.org
UA_BSC_MIN_CONFIRMATIONS=12

# Paystack leftover. Not the Ubuntu till. Do not set on Production.
UA_PAYSTACK_SECRET_KEY=
UA_PAYSTACK_PUBLIC_KEY=
